{
	"name": "sentence_database",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"type-check": "tsc --noEmit",
		"lint": "eslint",
		"postinstall": "prisma generate",
		"prisma:install-deps": "npm install prisma@^7 @prisma/client@^7 @prisma/adapter-mariadb dotenv",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"db:up": "docker compose up -d mysql",
		"db:down": "docker compose down",
		"db:logs": "docker compose logs -f mysql",
		"spellcheck": "cspell --no-progress \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,md}\"",
		"prepare": "husky"
	},
	"dependencies": {
		"@prisma/adapter-mariadb": "^7.0.0",
		"@prisma/client": "^7.0.0",
		"dotenv": "^17.0.0",
		"next": "16.1.6",
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"cspell": "^9.6.4",
		"eslint": "^9",
		"eslint-config-next": "16.1.6",
		"husky": "^9.1.7",
		"prettier": "^3.8.1",
		"prisma": "^7.0.0",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
}
