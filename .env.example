MYSQL_DATABASE=sentence_db
MYSQL_USER=sentence_user
MYSQL_PASSWORD=sentence_password
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

UPLOAD_VERIFY_PASSWORD=change-me
ACCESS_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-string
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Connection string for local development from the host machine
DATABASE_URL=mysql://sentence_user:sentence_password@localhost:3306/sentence_db
