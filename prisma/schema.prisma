generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Sentence {
  id      Int    @id @default(autoincrement())
  content String @db.LongText
}

model UnsafeTerm {
  id        Int      @id @default(autoincrement())
  term      String   @unique @db.VarChar(191)
  createdAt DateTime @default(now())
}
